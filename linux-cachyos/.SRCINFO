	depends = zlib
	depends = zstd
	depends = linux-cachyos
	depends = clang
	depends = llvm
	depends = lld
	depends = pahole>=1:1.32-2
	provides = LINUX-HEADERS
	provides = linux-cachyos-lto-headers=7.3.6-1
	replaces = linux-cachyos-lto-headers
