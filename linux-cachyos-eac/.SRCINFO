pkgname = linux-cachyos-eac
	pkgdesc = The Linux EEVDF + LTO Cachy Sauce Kernel by CachyOS configured for Easy Anti-Cheat Linux v2 kernel and modules
	depends = coreutils
	depends = kmod
	depends = initramfs
	optdepends = wireless-regdb: to set the correct wireless channels of your country
	optdepends = linux-firmware: firmware images needed for some devices
	optdepends = modprobed-db: Keeps track of EVERY kernel module that has ever been probed - useful for those of us who make localmodconfig
	optdepends = scx-scheds: to use sched-ext schedulers
	provides = VIRTUALBOX-GUEST-MODULES
	provides = WIREGUARD-MODULE
	provides = KSMBD-MODULE
	provides = V4L2LOOPBACK-MODULE
	provides = NTSYNC-MODULE
	provides = VHBA-MODULE
	provides = ADIOS-MODULE

pkgname = linux-cachyos-eac-headers
	pkgdesc = Headers and scripts for building modules for the Linux EEVDF + LTO Cachy Sauce Kernel by CachyOS configured for Easy Anti-Cheat Linux v2 kernel
	depends = binutils
	depends = glibc
	depends = libelf
	depends = libgcc
	depends = openssl
	depends = pahole
	depends = xxhash
	depends = zlib
	depends = zstd
	depends = linux-cachyos-eac
	depends = clang
	depends = llvm
	depends = lld
	provides = LINUX-HEADERS

pkgname = linux-cachyos-eac-nvidia-open
	pkgdesc = nvidia open modules of 615.78.08 driver for the linux-cachyos-eac kernel
	license = MIT AND GPL-2.0-only
	depends = linux-cachyos-eac=7.3.0-2
	depends = nvidia-utils=615.78.08
	depends = libglvnd
	provides = NVIDIA-MODULE
	conflicts = linux-cachyos-eac-nvidia
	conflicts = linux-cachyos-eac-nvidia-580xx

pkgname = linux-cachyos-eac-nvidia-580xx
	pkgdesc = nvidia module of 580.178.04 driver for the linux-cachyos-eac kernel
	license = custom
	depends = linux-cachyos-eac=7.3.0-2
	depends = nvidia-580xx-utils=580.178.04
	depends = libglvnd
	provides = NVIDIA-MODULE
	conflicts = linux-cachyos-eac-nvidia-open
